{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@controllers/*": ["controllers/*"],
      "@config/*": ["config/*"],
      "@cache/*": ["cache/*"],
      "@routes/*": ["routes/*"],
      "@models/*": ["models/*"],
      "@dto/*": ["dto/*"],
      "@middlewares/*": ["middlewares/*"],
      "@app/*": ["*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
}